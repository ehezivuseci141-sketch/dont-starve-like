; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="DontStarveLike"
config/description="A Don't Starve-like survival game built with Godot 4 + Claude Code"
config/version="0.1.0"
run/main_scene="res://scenes/main_scene.tscn"
config/features=PackedStringArray("4.6")

[autoload]

Signals="*res://shared/signals.gd"
Enums="*res://shared/enums.gd"
ItemDB="*res://shared/item_data.gd"
SurvivalManager="*res://core/survival.gd"
InventoryManager="*res://core/inventory.gd"
CraftingManager="*res://core/crafting.gd"
SaveManager="*res://core/save_system.gd"
DayNightCycle="*res://world/day_night.gd"
WeatherSystem="*res://world/weather.gd"
WorldManager="*res://world/world_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

